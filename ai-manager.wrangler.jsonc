{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "nowpulse-ai-manager",
  "main": "ai-manager.js",
  "compatibility_date": "2026-09-30",
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "NOWPULSE_KV",
      "id": "184c64ea1ed443e1bac081453cd599bf"
    }
  ],
  "vars": {
    "NOWPULSE_AI_REPAIR_MODE": "auto",
    "NOWPULSE_GITHUB_REPO": "Taha8880/NowPulse",
    "NOWPULSE_GITHUB_BRANCH": "main",
    "NOWPULSE_WORKER_FILE": "src/worker.js",
    "NOWPULSE_AI_MODEL": "@cf/zai-org/glm-4.7-flash"
  }
}
