{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "nowpulse",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "NOWPULSE_KV",
      "id": "184c64ea1ed443e1bac081453cd599bf"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "upload_source_maps": true,
  "vars": {
    "NOWPULSE_ENV": "production",
    "NOWPULSE_VERSION": "5.1.0",
    "NOWPULSE_AI_REPAIR": "enabled",
    "NOWPULSE_AI_REPAIR_MODE": "safe",
    "NOWPULSE_GITHUB_REPO": "Taha8880/NowPulse",
    "NOWPULSE_GITHUB_BRANCH": "main",
    "NOWPULSE_WORKER_FILE": "src/worker.js"
  }
}