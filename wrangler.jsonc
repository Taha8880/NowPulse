{
  "$schema":"https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name":"nowpulse",
  "main":"src/worker.js",
  "compatibility_date":"2026-09-30",
  "preview_urls":false,
  "vars":{"NOWPULSE_ENV":"production","NOWPULSE_VERSION":"1.6.0","ADSENSE_PUBLISHER_ID":"ca-pub-1235197294708204"},
  "triggers":{"crons":["*/15 * * * *"]},
  "observability":{"enabled":true,"logs":{"enabled":true},"traces":{"enabled":true,"head_sampling_rate":0.1}},
  "exports":{"NowPulseGuardian":{"type":"durable-object","storage":"sqlite"}}
}
